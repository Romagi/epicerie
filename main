import streamlit as st
from PIL import Image

# --- CONFIGURATION DE LA PAGE ---
st.set_page_config(
    page_title="Les Halles chez Vous - Côte Basque",
    page_icon="🛍️",
    layout="wide"
)

# --- STYLE CSS POUR LE "VIBE" PREMIUM ---
st.markdown("""
<style>
    .main-header {font-size: 2.5rem; color: #1E3A8A; font-weight: 700;}
    .sub-header {font-size: 1.2rem; color: #4B5563; margin-bottom: 2rem;}
    .shop-tag {background-color: #E5E7EB; padding: 2px 8px; border-radius: 10px; font-size: 0.8rem; color: #374151;}
    .price-tag {font-weight: bold; color: #059669; font-size: 1.1rem;}
    .info-box {background-color: #EFF6FF; padding: 1rem; border-radius: 8px; border-left: 4px solid #1E3A8A;}
</style>
""", unsafe_allow_html=True)

# --- INITIALISATION DU PANIER (SESSION STATE) ---
if 'cart' not in st.session_state:
    st.session_state.cart = {}

# --- LA BASE DE DONNÉES DES PRODUITS (Validée ensemble) ---
PRODUCTS = {
    "p1": {"name": "Jambon Blanc Supérieur", "shop": "Boucherie des Familles", "price": 4.50, "unit": "Les 2 tranches épaisses", "desc": "Le vrai goût du torchon, coupé minute.", "img": "🍖"},
    "p2": {"name": "Côte de Bœuf Maturée", "shop": "Boucherie des Familles", "price": 32.00, "unit": "Pièce d'env. 1kg", "desc": "Maturation 4 semaines. Idéal pour 3-4 pers.", "img": "🥩"},
    "p3": {"name": "Boîte de 6 Choux", "shop": "Maison Dune", "price": 16.00, "unit": "La boîte assortie", "desc": "Vanille, Caramel, Chocolat. Frais du matin.", "img": "🧁"},
    "p4": {"name": "Gâteau Basque Individuel (x4)", "shop": "Maison Adam", "price": 14.00, "unit": "Le lot de 4", "desc": "La référence absolue. Crème ou Cerise.", "img": "🥧"},
    "p5": {"name": "Ossau-Iraty d'Estive", "shop": "Fromagerie Arradoy", "price": 12.50, "unit": "La pointe (env. 500g)", "desc": "Affinage long, goût fruité.", "img": "🧀"},
    "p6": {"name": "Filet de Merlu de Ligne", "shop": "Poissonnerie Fagoaga", "price": 18.00, "unit": "Pour 2 personnes", "desc": "Pêche locale de la nuit à St-Jean.", "img": "🐟"},
    "p7": {"name": "Le Panier Maraîcher", "shop": "Primeur des Halles", "price": 22.00, "unit": "Panier Semaine (env 3kg)", "desc": "Sélection de saison : légumes + fruits.", "img": "🥦"},
}

# --- HEADER ---
st.markdown('<div class="main-header">🛍️ Les Halles chez Vous</div>', unsafe_allow_html=True)
st.markdown('<div class="sub-header">Le meilleur de St-Jean-de-Luz, Ciboure et Guéthary. Livré en une seule fois devant votre porte.</div>', unsafe_allow_html=True)

st.divider()

# --- AFFICHAGE DU CATALOGUE ---
col1, col2 = st.columns([2, 1], gap="large")

with col1:
    st.subheader("🌟 La sélection de la semaine")
    
    # On utilise des colonnes pour faire une grille de produits
    prod_cols = st.columns(2)
    
    i = 0
    for pid, p_data in PRODUCTS.items():
        # Logique pour alterner les colonnes
        with prod_cols[i % 2]:
            with st.container(border=True):
                # Placeholder pour l'image (à remplacer par de vraies photos plus tard)
                st.markdown(f"<div style='font-size: 4rem; text-align: center;'>{p_data['img']}</div>", unsafe_allow_html=True)
                
                st.markdown(f"### {p_data['name']}")
                st.markdown(f"<span class='shop-tag'>🏠 {p_data['shop']}</span>", unsafe_allow_html=True)
                st.write(p_data['desc'])
                
                st.markdown(f"<div class='price-tag'>{p_data['price']:.2f}€ <span style='font-size:0.8rem; color:#666;'>/ {p_data['unit']}</span></div>", unsafe_allow_html=True)
                
                # Sélecteur de quantité et bouton d'ajout
                c_qty, c_btn = st.columns([1, 2])
                with c_qty:
                    qty = st.number_input("Qté", min_value=1, max_value=10, value=1, key=f"qty_{pid}", label_visibility="collapsed")
                with c_btn:
                    if st.button("Ajouter au panier", key=f"btn_{pid}", type="secondary", use_container_width=True):
                        current_qty = st.session_state.cart.get(pid, 0)
                        st.session_state.cart[pid] = current_qty + qty
                        st.toast(f"✅ {qty}x {p_data['name']} ajouté !", icon="🛒")
        i += 1

# --- SIDEBAR : PANIER & CHECKOUT "VIBE" ---
with col2:
    with st.container(border=True):
        st.markdown("### 🛒 Votre Panier Estimatif")
        
        if not st.session_state.cart:
            st.info("Votre panier est vide. Ajoutez des pépites locales !")
        else:
            total_products = 0
            for pid, qty in st.session_state.cart.items():
                p_data = PRODUCTS[pid]
                line_total = p_data['price'] * qty
                total_products += line_total
                
                # Affichage ligne par ligne
                st.markdown(f"**{qty}x {p_data['name']}**")
                st.markdown(f"<small>{p_data['shop']}</small>", unsafe_allow_html=True)
                st.markdown(f"<div style='text-align: right;'>{line_total:.2f}€</div>", unsafe_allow_html=True)
                st.divider()
            
            # Calculs finaux
            delivery_fee = 6.00
            grand_total_estimated = total_products + delivery_fee
            
            st.write(f"Sous-total produits : {total_products:.2f}€")
            st.write(f"Frais de livraison (Zone Côte Basque Sud) : {delivery_fee:.2f}€")
            
            st.markdown(f"""
            <div style='background-color: #ECFDF5; padding: 1rem; border-radius: 8px; text-align: center; margin-top: 1rem;'>
                <span style='font-size: 1rem; color: #065F46;'>Total Estimé à régler :</span><br>
                <span style='font-size: 1.8rem; font-weight: bold; color: #047857;'>{grand_total_estimated:.2f}€</span>
            </div>
            """, unsafe_allow_html=True)
            
            # --- LA TOUCHE "VIBE" : Note sur l'ajustement des prix ---
            st.markdown("""
            <div class='info-box' style='margin-top: 1.5rem; font-size: 0.9rem;'>
                <strong>ℹ️ Transparence Totale :</strong><br>
                Ce montant est une estimation. Le prix final sera ajusté à l'euro près après la pesée réelle chez les artisans (ex: le poids exact de votre Côte de Bœuf). <br>
                <em>Vous ne paierez que le prix réel des Halles + la livraison.</em>
            </div>
            """, unsafe_allow_html=True)
            
            st.write("") # Spacer

            # --- BOUTON D'ACTION ---
            if st.button("✨ Valider avec mon Personal Shopper ✨", type="primary", use_container_width=True):
                st.balloons()
                
                # Simulation du message qui serait envoyé
                st.success("🎉 Commande pré-validée !")
                
                # Construction du message pour WhatsApp (Simulation)
                whatsapp_message = "Salut ! Voici ma commande test PoC :%0A"
                for pid, qty in st.session_state.cart.items():
                    whatsapp_message += f"- {qty}x {PRODUCTS[pid]['name']}%0A"
                whatsapp_message += f"%0ATotal estimé : {grand_total_estimated:.2f}€"
                
                # En production, ceci serait un lien automatique vers WhatsApp
                st.markdown(f"""
                <div style='text-align: center; margin-top: 1rem;'>
                    <a href='https://wa.me/?text={whatsapp_message}' target='_blank' style='background-color: #25D366; color: white; padding: 10px 20px; border-radius: 5px; text-decoration: none; font-weight: bold;'>
                        👉 CLIQUE ICI pour finaliser sur WhatsApp
                    </a>
                    <p style='font-size: 0.8rem; color: #666; margin-top: 5px;'>(Simule l'envoi à l'agent IA)</p>
                </div>
                """, unsafe_allow_html=True)
                
                # Option pour vider le panier pour refaire un test
                if st.button("Vider le panier et recommencer"):
                    st.session_state.cart = {}
                    st.rerun()
